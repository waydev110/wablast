APP_NAME=MPWA
APP_ENV=production
APP_KEY=base64:PxGRSZnMJVvMO7erMUXd683lMJwYFWpdxufKRbugeq8=
APP_DEBUG=false
APP_URL=https://wablast.inilaku.com

# Node.js Server Configuration
# IMPORTANT: Shared hosting blocks external access to port 3100
# Use localhost for internal connection (Laravel → Node.js on same server)
WA_URL_SERVER=http://localhost
PORT_NODE=3100

# Alternative options if localhost doesn't work:
# Option 1: Use 127.0.0.1
# WA_URL_SERVER=http://127.0.0.1
# PORT_NODE=3100

# Option 2: Deploy Node.js to external service (Railway, Render, Fly.io)
# WA_URL_SERVER=https://your-app.railway.app
# PORT_NODE=443

# Option 3: Use reverse proxy via Apache
# WA_URL_SERVER=https://wablast.inilaku.com/node
# PORT_NODE=
APP_INSTALLED=true
LICENSE_KEY=MagdAlmuntaser
BUYER_EMAIL=admin@admin.com
TYPE_SERVER=hosting

# Database Configuration for Production
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=iniz8459_wablast
DB_USERNAME=iniz8459_wablast
DB_PASSWORD=wablast2025

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Cache & Queue
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis (optional - if shared hosting supports)
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# AI Bot Configuration
CHATGPT_URL=https://api.openai.com/v1/chat/completions
CHATGPT_MODEL=gpt-3.5-turbo
GEMINI_MODEL=gemini-1.5-flash
CLAUDE_URL=https://api.anthropic.com/v1/messages
CLAUDE_MODEL=claude-3-sonnet-20240229
DALLE_SIZE=256x256
DALLE_URL=https://api.openai.com/v1/images/generations

# Pusher (not needed for HTTP polling mode)
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Server Configuration
PORT=3000
AUTH=mpedia-server-uUdkfgli783pkfnlaskogoighr

# Theme Configuration
THEME_NAME=mpwa
THEME_INDEX=lezir
ENABLE_INDEX=yes

# Webhook & Origin
ORIGIN=https://wablast.inilaku.com
WEBHOOK=

# Mail Configuration (Update with your SMTP details)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@wablast.inilaku.com
MAIL_FROM_NAME="${APP_NAME}"

# Trial/Free Plan Limits
TRIAL_MESSAGE_LIMIT=50
TRIAL_DEVICES_LIMIT=1

# Payment Gateway - Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Payment Gateway - PayPal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# Payment Gateway - Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Payment Gateway - Paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC=

# Security - Two Factor Authentication
GOOGLE2FA_ENABLE=true

# Timezone (adjust to your location)
APP_TIMEZONE=Asia/Jakarta

# Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# HTTP Polling Mode Settings (for shared hosting)
# QR code polling interval: 2 seconds (2000ms)
# Connection timeout: 30 seconds
POLLING_INTERVAL=2000
CONNECTION_TIMEOUT=30

# IMPORTANT: After upload to server, ensure these folders exist with correct permissions:
# - storage/framework/cache/data (775)
# - storage/framework/sessions (775)
# - storage/framework/views (775)
# - storage/logs (775)
# - bootstrap/cache (755)
# Run: bash fix-permissions.sh OR visit: /fix-storage.php (then delete it!)
